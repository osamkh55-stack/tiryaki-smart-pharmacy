{
  "expo": {
    "name": "تِرياقي",
    "slug": "teryaqi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#176B57"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.teryaqi.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#176B57"
      },
      "package": "com.teryaqi.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-splash-screen"
    ],
    "extra": {
      "eas": {
        "projectId": "teryaqi-app"
      }
    }
  }
}
